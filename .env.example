# Copy to `.env` and adjust values.

# Required for login/register and protected routes
JWT_SECRET=spezia-assignment-backend-secret-key

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/webhooks

# HTTP port (frontend often defaults API calls to http://localhost:4000)
PORT=4000

# Allowed browser origin for CORS (Vite dev server by default)
FRONTEND_ORIGIN=http://localhost:5173

# Optional: RabbitMQ — when set, ingest jobs are queued; otherwise processed inline.
# Local broker: uncomment and run `docker compose up -d` in this folder (compose is RabbitMQ-only).
# RABBITMQ_URL=amqp://webhook:webhook@127.0.0.1:5672

# Optional
# JWT_EXPIRES_IN=8h
# JSON_BODY_LIMIT=256kb
